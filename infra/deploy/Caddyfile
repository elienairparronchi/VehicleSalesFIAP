{$PUBLIC_HOST} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	redir /auth /auth/

	handle /auth/* {
		reverse_proxy keycloak:8080
	}

	handle {
		reverse_proxy api:8080
	}

	log {
		output stdout
		format console
	}
}
